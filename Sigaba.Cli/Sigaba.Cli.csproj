<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CA1873;IDE0290</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.0.0-alpha</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sigaba</ToolCommandName>
    <Authors>Kintino software</Authors>
    <Company>Kintino software</Company>
    <Description>
      Sigaba is a command-line tool that encrypts/decrypts configuration files.
    </Description>
    <PackageTags>cipher;cryptography;encryption;decryption;configuration;cli;appsettings</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Readme.md" Pack="true" PackagePath="/"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Readme.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sigaba.Cli.IntegrationTest" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sigaba.App\Sigaba.App.csproj" />
  </ItemGroup>

</Project>
